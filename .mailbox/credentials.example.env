# Mailbox operator credentials. GITIGNORED. Copy from
# .mailbox/credentials.example.env; values are never logged or printed.
#
# Lifecycle classes:
#   operator-local      -> local central store only; management/control plane;
#                          NEVER installed into the Worker
#   persistent          -> installed as Worker secrets (credentials:apply)
#   transient           -> used once, then deleted (ADMIN_BOOTSTRAP_TOKEN)

# Operator-local (operator machine only)
CLOUDFLARE_API_TOKEN=
RESEND_SETUP_API_KEY=
BREVO_SETUP_API_KEY=

# Persistent common runtime
AUTH_PEPPER=
CLOUDFLARE_ROUTING_READ_TOKEN=

# Transient (delete after bootstrap)
ADMIN_BOOTSTRAP_TOKEN=

# Resend (when OUTBOUND_PROVIDER=resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Brevo (when OUTBOUND_PROVIDER=brevo)
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=

# Cloudflare outbound: no runtime sending token (Worker send_email binding)
