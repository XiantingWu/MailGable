#!/bin/sh
set -eu

MSG_FILE="$1"

if grep -n -i -E '^(Co-authored-by|on-behalf-of|Generated-by|Created-by|Assisted-by|AI-generated-by):' "$MSG_FILE"; then
  echo "commit-msg: ATTRIBUTION BLOCKER: forbidden attribution trailer in commit message" >&2
  exit 1
fi

if grep -n -i -E '^(OpenAI|Anthropic|GitHub Copilot|Cursor|Codex|Claude Code)' "$MSG_FILE"; then
  echo "commit-msg: ATTRIBUTION BLOCKER: forbidden attribution body in commit message" >&2
  exit 1
fi

exit 0