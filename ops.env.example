# Operator credentials for deployment automation (setup-only).
#
# These are NOT runtime secrets. They are temporary, broad-scope credentials
# used once during provisioning. Create them for the operation, use them, then
# revoke/delete them immediately. Never install them into the Worker runtime
# and never commit them.
#
# Lifecycle classes:
#   setup-only (temporary)   -> create, provision, revoke
#   runtime (Worker secrets) -> `wrangler secret put`, see .dev.vars.example
#
# Copy to `.env` or your secret manager for the operator session only.

# read-only inventory / preflight (may persist if scoped read-only)
CLOUDFLARE_READ_TOKEN=""

# temporary write token for cutover; revoke after deployment
CLOUDFLARE_DEPLOY_TOKEN=""

# temporary; used only for domain/webhook setup, then revoked
RESEND_SETUP_FULL_ACCESS_KEY=""

# domain-restricted sending key, installed as RESEND_API_KEY
RESEND_PRODUCTION_SENDING_ACCESS_KEY=""

# local-only administrator password for automation bootstrap
MAILBOX_ADMIN_PASSWORD=""